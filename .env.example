# Leave blank for first-account setup on this local computer.
# A strong private setup code is required for hosted production installations.
SETUP_CODE=
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
DATABASE_PATH=./data/together.sqlite
PORT=3001
HOST=127.0.0.1
# Set production only behind HTTPS: cookies will require HTTPS.
NODE_ENV=development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional calendar organizer; defaults to SMTP_FROM. Use a mailbox you control.
CALENDAR_ORGANIZER_EMAIL=
# Preferred WhatsApp: Evolution API (https://github.com/EvolutionAPI/evolution-api)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Optional fallback if Evolution is not configured
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
